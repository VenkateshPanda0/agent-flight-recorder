# Copy this file to .env and fill in your own PayPal sandbox credentials.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional
# PAYPAL_WEBHOOK_ID=
# ANTHROPIC_API_KEY=   (only for the live-model agent; the scripted agent needs nothing)
# DEMO_PAYPAL=simulated   (never calls PayPal)
